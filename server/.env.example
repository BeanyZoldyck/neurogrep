PORT=8787
# MongoDB Atlas (clip registry)
MONGODB_URI=
# Tiger Data / Timescale cloud Postgres.
# Event telemetry (vericam_events) and share proofs (vericam_proofs, vericam_proof_checks).
# Standard Postgres URL. Proofs also accept DATABASE_URL when TIGER_DATABASE_URL is empty.
# Use the Tiger Cloud string with sslmode=require. Leave blank to run without corroboration.
TIGER_DATABASE_URL=
# Public S3 bucket. Reads are anonymous GetObject. Listing is not public.
# Default object URL: https://neurogrep-public-1794752476.s3.amazonaws.com/<key>
S3_BUCKET=neurogrep-public-1794752476
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://neurogrep-public-1794752476.s3.amazonaws.com
# IAM keys for upload and authenticated ListBucket. Leave blank for public verify only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional S3-compatible API (R2, MinIO, moto). Unset for AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
# Leave empty. This bucket grants GetObject by policy. Set public-read only for ACL-based MinIO.
S3_OBJECT_ACL=
# Bearer token for POST /api/share/videos and POST /api/share/sweep. Invent a long random string.
VERICAM_UPLOAD_KEY=
# Optional in-process sweep. Unset disables it. Minimum 10000. Listing uses the IAM keys above;
# without them the sweep walks Tiger Data keys and GETs each public URL.
SHARE_SWEEP_INTERVAL_MS=
SHARE_SWEEP_LIMIT=500
SHARE_KEY_PREFIX=videos/
# Solana (digest anchoring via SPL Memo). Secret key: JSON array or base58. `npm run solana:keygen`
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_SECRET_KEY=
# Google Gemini (UGC twin + judge explanations)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
