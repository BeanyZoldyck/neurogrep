[Unit]
Description=VeriCam API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vericam
WorkingDirectory=/opt/vericam/server
EnvironmentFile=-/opt/vericam/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
